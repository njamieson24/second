# Copy this file to .env.local and fill in the two values.
# Supabase dashboard: open your project, click "Connect" at the top (or Project Settings > API Keys).

# Project URL, like https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Never the secret / service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (no NEXT_PUBLIC_): emails allowed to use "Load demo data" on /settings. Comma-separated.
DEMO_DATA_EMAILS=

# The live site address (not secret). Used for link preview images, like on LinkedIn.
NEXT_PUBLIC_SITE_URL=
